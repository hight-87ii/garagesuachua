OPENAI_API_KEY=sk-thay-api-key-cua-ban-vao-day
GEMINI_API_KEY=thay-gemini-api-key-cua-ban-vao-day

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Đặt true khi ứng dụng chạy qua HTTPS.
COOKIE_SECURE=false

# Hiện khối tài khoản dùng thử ở trang đăng nhập. Đặt false ở production.
SHOW_DEMO_ACCOUNTS=true
# Thời hạn cookie khi tick "Ghi nhớ tôi" (phút). Mặc định 30 ngày.
REMEMBER_ME_EXPIRE_MINUTES=43200

# --- Chính sách lịch làm việc (tùy chọn; mặc định: nghỉ các ngày lễ lớn) ---
# Ngày lễ cố định theo DD-MM, cách nhau dấu phẩy.
# Mặc định: 01-01,30-04,01-05,02-09
# GARAGE_HOLIDAYS_DDMM=01-01,30-04,01-05,02-09
# Ngày nghỉ cụ thể theo YYYY-MM-DD (VD nghỉ Tết), cách nhau dấu phẩy.
# GARAGE_HOLIDAYS=2027-02-06,2027-02-07
# Thứ trong tuần xưởng nghỉ (0=Thứ Hai ... 6=Chủ Nhật). Mặc định 6 (nghỉ Chủ Nhật).
# Đặt rỗng để mở cả tuần.
# GARAGE_CLOSED_WEEKDAYS=
